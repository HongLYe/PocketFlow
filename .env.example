# ==============================================================================
# PocketFlow Environment Configuration (.env.example)
#
# NOTE: PocketFlow is a local-first application. All financial records, accounts,
# and budgets are stored 100% in the user's browser via IndexedDB (Dexie).
# There are no remote backend database credentials or secret API keys required.
# ==============================================================================

# Server / Container Port (Used by docker-compose)
# Defines the host port mapped to the Nginx HTTP server inside the container.
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production
